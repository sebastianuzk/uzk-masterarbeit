{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Streamlit App (Single-Agent)",
			"type": "shell",
			"command": "source .venv/bin/activate && python main.py --ui",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Start Streamlit App (Multi-Agent)",
			"type": "shell",
			"command": "source .venv/bin/activate && python main.py --ui --agent-mode multi",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Run CLI (Single-Agent)",
			"type": "shell",
			"command": "source .venv/bin/activate && python main.py",
			"group": "build",
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Run CLI (Multi-Agent)",
			"type": "shell",
			"command": "source .venv/bin/activate && python main.py --agent-mode multi",
			"group": "build",
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Run Tests",
			"type": "shell",
			"command": "source .venv/bin/activate && python -m pytest tests/",
			"group": "test",
			"isBackground": false,
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		}
	]
}