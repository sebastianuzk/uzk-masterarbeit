# RAG Hyperparameter Configuration
# =================================
# Diese Datei enthält NUR Hyperparameter für die einzelnen Advanced-Techniken.
# Aktivierung/Deaktivierung erfolgt über RAGConfig.naive_setup im Code.

# === GENERAL RETRIEVAL SETTINGS ===
# Anzahl der finalen Dokumente, die an den Agent übergeben werden (gilt für alle Retrieval-Ansätze)
TOP_K=5

# === MASTER SWITCH ===
# false = Advanced RAG (individuelle Features können aktiviert werden)
# true  = Naive Baseline (alle Techniken deaktiviert)
RAG_NAIVE_SETUP=false

# === INDIVIDUAL FEATURE FLAGS ===
# Nur aktiv wenn RAG_NAIVE_SETUP=false
ENABLE_SEMANTIC_CHUNKING=false
ENABLE_CONTENT_CLEANING=false
ENABLE_DEDUPLICATION=false
ENABLE_MULTI_COLLECTION=false
ENABLE_RESULT_AGGREGATION=false
ENABLE_DISTANCE_CONVERSION=false
ENABLE_GLOBAL_RERANKING=false
ENABLE_RELEVANCE_FILTERING=false
ENABLE_RESULT_FORMATTING=false
ENABLE_CONTEXT_HINTS=false
ENABLE_EMPTY_RESULT_HANDLING=false
ENABLE_HYBRID_RETRIEVAL=false
ENABLE_SPARSE_RETRIEVAL=false
ENABLE_RERANKING=true




# === PRE-RETRIEVAL HYPERPARAMETER ===

# Semantic Chunking
SEMANTIC_CHUNKING_MAX_SIZE=1500
SEMANTIC_CHUNKING_MIN_SIZE=500
SEMANTIC_CHUNKING_OVERLAP=300
# Breakpoint-Methode: Static Threshold vs Percentile
# Wenn USE_PERCENTILE=true: Breakpoints bei Similarities im niedrigsten X. Perzentil
# Wenn USE_PERCENTILE=false: Breakpoints bei Similarity < SIMILARITY_THRESHOLD
SEMANTIC_CHUNKING_USE_PERCENTILE=True
SEMANTIC_CHUNKING_PERCENTILE=10
SEMANTIC_CHUNKING_SIMILARITY_THRESHOLD=0.4

# Naive Chunking (fallback wenn Semantic Chunking deaktiviert)
NAIVE_CHUNKING_MAX_SIZE=1500
NAIVE_CHUNKING_OVERLAP=300

# Content Cleaning
CONTENT_CLEANING_MIN_LENGTH=50
CONTENT_CLEANING_REMOVE_HTML=true
CONTENT_CLEANING_NORMALIZE_WHITESPACE=true

# Deduplication (Exact)
DEDUPLICATION_SIMILARITY_THRESHOLD=0.95
DEDUPLICATION_SHINGLE_SIZE=3

# Near-Deduplication (Document-Level)
NEAR_DEDUPLICATION_SHINGLE_K=5
NEAR_DEDUPLICATION_SIMILARITY_THRESHOLD=0.95
NEAR_DEDUPLICATION_MIN_WORDS=120
NEAR_DEDUPLICATION_NUM_PERM=128

# === RETRIEVAL HYPERPARAMETER ===

# === HYBRID RETRIEVAL (BM25 Sparse Index + RRF) ===
# RRF-K Parameter (höher = mehr Gewicht auf niedrigere Ränge)
RRF_K=60
# Kandidaten pro Retrieval-Type (Dense + Sparse ziehen jeweils so viele)
HYBRID_RETRIEVAL_K_RETRIEVE=80

# Multi-Collection Search
MULTI_COLLECTION_K_PER_COLLECTION=2

# Distance Conversion
DISTANCE_CONVERSION_MIN_DISTANCE=0.0
DISTANCE_CONVERSION_MAX_DISTANCE=2.0

# Global Reranking
GLOBAL_RERANKING_MAX_PER_SOURCE=2
GLOBAL_RERANKING_DIVERSITY_PENALTY=0.1

# === POST-RETRIEVAL HYPERPARAMETER ===

# Relevance Filtering
RELEVANCE_FILTERING_THRESHOLD=0.1
RELEVANCE_FILTERING_MIN_RESULTS=1

# Result Formatting
RESULT_FORMATTING_INCLUDE_METADATA=true
RESULT_FORMATTING_INCLUDE_SOURCES=true
RESULT_FORMATTING_MAX_PREVIEW_LENGTH=200

# Context Hints
CONTEXT_HINTS_ENABLED_CATEGORIES=contact,tips,related
CONTEXT_HINTS_MAX_HINTS=3

# Empty Result Handling
EMPTY_RESULT_FALLBACK_MESSAGE=Keine relevanten Informationen gefunden.
EMPTY_RESULT_SUGGEST_ALTERNATIVES=true

# === RERANKING (Voyage AI) ===
# Modell für ReRanking (rerank-2.5 ist das aktuelle Modell)
RERANKING_MODEL=rerank-2.5
# Anzahl der Top-Dokumente die dem ReRanker übergeben werden (reduziert API-Kosten)
RERANKING_CANDIDATES=40

# === EMBEDDING MODEL ===
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_DIMENSION=1024

# === VECTOR DATABASE ===
VECTOR_DB_PATH=data/vector_db
VECTOR_DB_DISTANCE_METRIC=cosine

# === GENERAL SETTINGS ===
DEBUG_MODE=false
LOG_LEVEL=INFO
