# =============================================================================
# Scraper Configuration - Advanced RAG Features
# =============================================================================
# Diese Datei steuert welche Advanced RAG-Features aktiviert werden.
# Standardmäßig läuft der Scraper im "Naive RAG" Modus.
# 
# WICHTIG: Setze Werte auf 'true' um Features zu aktivieren, 'false' zum Deaktivieren
# =============================================================================

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================
# Intelligentes URL-Caching (verhindert redundantes Scraping)
ENABLE_CACHING=false

# Inkrementelles Scraping (nur Änderungen re-scrapen)
ENABLE_INCREMENTAL_SCRAPING=false

# Cache-Gültigkeit in Stunden (nur relevant wenn CACHING=true)
CACHE_VALIDITY_HOURS=24

# =============================================================================
# CONTENT PROCESSING
# =============================================================================
# Content-Deduplizierung (entfernt duplicate Inhalte)
ENABLE_DEDUPLICATION=false

# Erweiterte Content-Bereinigung (HTML-Tags, Formatierung etc.)
ENABLE_CONTENT_CLEANING=false

# Semantisches Chunking (intelligente Text-Segmentierung)
ENABLE_SEMANTIC_CHUNKING=false

# Content-Qualitätsbewertung
ENABLE_QUALITY_ASSESSMENT=false

# =============================================================================
# METADATA ENRICHMENT
# =============================================================================
# Erweiterte Metadata-Anreicherung (Kategorien, Topics etc.)
ENABLE_METADATA_ENRICHMENT=false

# Automatische Content-Kategorisierung
ENABLE_AUTO_CATEGORIZATION=false

# URL-basierte Kategorisierung
ENABLE_URL_CATEGORIZATION=false

# =============================================================================
# ROBUSTNESS & RESILIENCE
# =============================================================================
# Resilient Scraping (Retry-Logic mit Exponential Backoff)
ENABLE_RESILIENT_SCRAPING=false

# Maximale Anzahl Retries für fehlgeschlagene URLs
MAX_RETRIES=3

# Initial Retry-Delay in Sekunden
INITIAL_RETRY_DELAY=2.0

# Maximaler Retry-Delay in Sekunden
MAX_RETRY_DELAY=60.0

# =============================================================================
# VECTOR STORE OPTIMIZATION
# =============================================================================
# Separate Collections pro Kategorie (statt einer großen Collection)
ORGANIZE_BY_CATEGORY=false

# Erweiterte Embedding-Konfiguration
ENABLE_ADVANCED_EMBEDDINGS=false

# Custom Embedding-Modell (falls ADVANCED_EMBEDDINGS=true)
CUSTOM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Detaillierte Scraper-Metriken
ENABLE_DETAILED_METRICS=false

# Content-Change-Detection
ENABLE_CHANGE_DETECTION=false

# Performance-Monitoring
ENABLE_PERFORMANCE_MONITORING=false

# Export von Scraping-Reports
ENABLE_REPORT_EXPORT=false

# =============================================================================
# PDF PROCESSING
# =============================================================================
# Erweiterte PDF-Verarbeitung
ENABLE_ADVANCED_PDF_PROCESSING=false

# PDF-Metadaten-Extraktion
ENABLE_PDF_METADATA_EXTRACTION=false

# PDF-OCR für gescannte Dokumente
ENABLE_PDF_OCR=false

# =============================================================================
# ERROR HANDLING & LOGGING
# =============================================================================
# Detailliertes Error-Logging
ENABLE_DETAILED_ERROR_LOGGING=false

# Failed URLs Export
ENABLE_FAILED_URLS_EXPORT=false

# =============================================================================
# EXPERIMENTAL FEATURES
# =============================================================================
# Machine Learning-basierte Content-Analyse
ENABLE_ML_CONTENT_ANALYSIS=false

# Automatische Keyword-Extraktion
ENABLE_KEYWORD_EXTRACTION=false

# Content-Similarity-Clustering
ENABLE_SIMILARITY_CLUSTERING=false

# =============================================================================
# DEBUGGING
# =============================================================================
# Debug-Modus (ausführliche Logs)
DEBUG_MODE=false

# Trockenlauf (crawl aber scrape nicht)
DRY_RUN=false

# Limitiere Anzahl URLs für Tests
DEBUG_MAX_URLS=0