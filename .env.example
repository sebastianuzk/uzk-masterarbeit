# Umgebungsvariablen für den Autonomen Chatbot-Agenten
# Vorlage: Datei kopieren und als ".env" im Projektstamm ablegen.
# Werte mit <...> müssen individuell befüllt werden.

# ============================================================================
# OLLAMA / CHATBOT KONFIGURATION
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM Parameter (werden von Chatbot UND Evaluation verwendet)
# ReactAgent berechnet CONTEXT_WINDOW dynamisch basierend auf Modellgröße:
# 0.5b → 2048 | 1b → 4096 | 3b → 8192 | 7b/8b → 14500 | 20b/70b → 16384
TEMPERATURE=0.0
CONTEXT_WINDOW=14500

# ============================================================================
# RAGAS EVALUATION KONFIGURATION
# ============================================================================
# Separates Modell für lokale Metrik-Berechnung (Ollama)
RAGAS_EVAL_MODEL=qwen2.5:7b

# OpenAI für Cloud-basierte Metrik-Berechnung
OPENAI_EVAL_MODEL=gpt-4.1-mini
OPENAI_API_KEY=<your-openai-api-key>

# Evaluation Mode: true = lokal (Ollama), false = Cloud (OpenAI)
RUN_EVALUATION_LOCAL=false

# ============================================================================
# REPRODUZIERBARKEIT
# ============================================================================
RANDOM_SEED=42

# ============================================================================
# LANGSMITH TRACING
# ============================================================================
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=<your-project-name>
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=

# ============================================================================
# VOYAGE AI (ReRanking)
# ============================================================================
VOYAGE_API_KEY=<your-voyage-api-key>

# ============================================================================
# COHERE AI (ReRanking)
# ============================================================================
COHERE_API_KEY=<your-cohere-api-key>

# ============================================================================
# E-MAIL-KONFIGURATION (Gmail SMTP)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-gmail-address>
SMTP_PASSWORD=<your-gmail-app-password>
DEFAULT_RECIPIENT=<default-recipient-email>
